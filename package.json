{
  "name": "omp-slack-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session-scoped, default-off Slack Socket Mode bridge for oh-my-pi",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@slack/socket-mode": "2.0.7",
    "@slack/web-api": "7.13.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.10.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
