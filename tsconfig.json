{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ES2024"
    ]
  },
  "include": [
    "index.ts",
    "windows.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
